# Thư mục gói New Way (chép nguyên New Way/xuat_app). Tương đối tính từ predict/, hoặc đường dẫn tuyệt đối.
# Các file mô hình (.pt, lam_sang_app_xgb.json) nằm trong <NEW_WAY_DIR>/mo_hinh/ — KHÔNG đưa vào git.
NEW_WAY_DIR=ml/new_way
# true = nạp 3 mạng ảnh ngay khi khởi động (~1.5 GB RAM); false = nạp ở lần gửi ảnh đầu tiên
PRELOAD_IMAGE_MODEL=true
# auto | cpu | cuda
DEVICE=auto
MAX_UPLOAD_MB=10
MAX_CLINICAL_KB=64
