
# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/silicocare
DB_USER=silicocare
DB_PASSWORD=change-me
POSTGRES_DB=silicocare

# --- JWT (HS256): chuỗi ngẫu nhiên >= 32 byte, ví dụ: openssl rand -base64 48 ---
JWT_SECRET=

# --- Tài khoản admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-123

# --- SMTP ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=SilicoCare <your-account@gmail.com>

# --- X-quang ---
# Thư mục lưu ảnh; bỏ trống thì dùng ~/.silicocare/images.
# Không dùng ${...} ở đây: docker compose --env-file sẽ báo "Invalid template".
# APP_STORAGE_IMAGES_DIR=C:/silicocare/images
APP_IMAGE_MAX_UPLOAD_SIZE=10MB
APP_IMAGE_MAX_REQUEST_SIZE=11MB
APP_IMAGE_MIN_SHORT_SIDE=256
APP_IMAGE_MAX_DIMENSION=8000

# --- Hồ sơ bệnh nhân ---
# Số ký tự tối đa cho tiền sử phơi nhiễm và yếu tố nguy cơ.
APP_PATIENT_MAX_TEXT_LENGTH=2000

# --- Lượt khám ---
# Giới hạn trường JSON tự do "extra": kích thước khi viết thành JSON và số cấp lồng.
APP_VISIT_EXTRA_MAX_SIZE=8KB
APP_VISIT_EXTRA_MAX_DEPTH=3

# --- Dự đoán (service FastAPI trong predict/) ---
# false: không tự dự đoán khi gắn ảnh vào lượt khám.
PREDICT_ENABLED=true
PREDICT_BASE_URL=http://localhost:8001
PREDICT_TIMEOUT=30s
PREDICT_CONNECT_TIMEOUT=3s
